# --- Emacs generated / transient files --------------------------------------
# Backups, auto-saves, lock files
*~
\#*\#
.\#*
*.swp

# Byte / native compilation output
*.elc
*.eln
eln-cache/

# Auto-save list
auto-save-list/

# --- Package managers -------------------------------------------------------
elpa/
elpaca/

# Installed packages under site-lisp, but keep hand-written lisp
site-lisp/*/
!site-lisp/*.el

# --- Runtime state / caches -------------------------------------------------
transient/
eshell/
url/
logs/
projects
history
recentf
savehist
places
bookmarks
tramp
request/
network-security.data
.emacs.desktop
.emacs.desktop.lock

# --- Editor / OS cruft ------------------------------------------------------
.DS_Store
*.log

# custom.el is generated by Customize but kept under version control here.
# Uncomment the next line if you prefer to ignore it.
# custom.el
